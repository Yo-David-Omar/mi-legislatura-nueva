---
import BaseLayout from './Layout.astro';

interface Props {
  title: string;
  numero: number;
  reunion: string;
  fecha: string;
  tipo: string;
  periodo: number;
}

const { title, numero, reunion, fecha, tipo, periodo } = Astro.props;
---

<BaseLayout title={title}>
  <article class="sesion-content">
    <header class="sesion-header">
      <h1>{periodo}° Período Legislativo</h1>
      <h2>Diario de Sesiones N° {numero}</h2>
      <p class="sesion-meta">{reunion} REUNIÓN - {tipo}</p>
      <p class="sesion-date">{fecha}</p>
    </header>
    
    <div class="sesion-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .sesion-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }
  
  .sesion-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid #8B4513;
  }
  
  .sesion-header h1 {
    color: #1a365d;
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .sesion-header h2 {
    color: #2c5282;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  
  .sesion-meta {
    color: #4a5568;
    font-size: 1.1rem;
    font-weight: 600;
  }
  
  .sesion-date {
    color: #718096;
    font-style: italic;
  }
  
  .sesion-body h3 {
    color: #1a365d;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
  }
  
  .sesion-body p {
    line-height: 1.8;
    margin-bottom: 1rem;
    text-align: justify;
  }
  
  .sesion-body strong {
    color: #2d3748;
    font-weight: 700;
  }
</style>