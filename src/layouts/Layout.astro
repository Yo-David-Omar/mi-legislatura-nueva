---
import '../styles/global.css'; 

interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { text: "INICIO", url: "/" },
  { text: "AUTORIDADES", url: "#" },
  { text: "MANDATOS Y SEC. ELECTORALES", url: "#" },
  { text: "INDICE TEMÁTICO", url: "#" },
  { text: "ACTIVIDAD PARLAMENTARIA", url: "#" },
  { text: "COMISIONES", url: "#" },
  { text: "DIARIO DE SESIONES", url: "/diario-sesiones" },
  { text: "CUADRO DE LEYES", url: "#" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700;900&display=swap" rel="stylesheet">
    <title>{title} - Legislatura de Tucumán</title>
  </head>
  
  <body class="bg-gray-100 min-h-screen" style="font-family: 'Merriweather', serif;">
    
    <!-- CABECERA COMPLETA FIJA -->
    <div id="header-wrapper" class="fixed top-0 left-0 w-full z-50">

      <!-- NAVBAR -->
      <nav class="bg-red-900 text-white shadow-lg">
        <div class="container mx-auto px-4">
          <ul class="hidden md:flex flex-wrap justify-center gap-6 py-3 text-sm font-bold">
            {navLinks.map((link) => (
              <li>
                <a href={link.url} class="hover:text-yellow-300 transition tracking-wide">
                  {link.text}
                </a>
              </li>
            ))}
          </ul>

          <div x-data="{ open: false }" class="md:hidden flex justify-center py-3">
            <button @click="open = !open" class="text-white border-2 border-white px-4 py-2 rounded font-bold">
              <i class="bi bi-list mr-2"></i>MENÚ
            </button>

            <ul
              x-show="open"
              @click.outside="open = false"
              class="absolute top-full left-0 w-full bg-red-950 flex flex-col p-4 gap-2 text-center shadow-xl z-50"
            >
              {navLinks.map((link) => (
                <li>
                  <a href={link.url} class="block py-3 border-b border-white/20 hover:bg-white/10 font-bold">
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>

      <!-- HEADER -->
      <header
        id="main-header"
        class="bg-white/95 backdrop-blur-sm shadow-md transition-all duration-300"
      >
        <div class="container mx-auto px-4 flex flex-col md:flex-row items-center justify-center gap-6 py-2">

          <div>
            <img
              id="logo"
              src="/imagenescudo/hlegislatura.png"
              alt="Escudo Legislatura"
              class="h-20 w-auto transition-all duration-300"
            >
          </div>

          <div class="flex-grow text-center md:text-center">
            <h1
              id="titulo"
              class="text-2xl md:text-3xl font-black text-gray-800 tracking-wider uppercase transition-all duration-300"
            >
              HONORABLE LEGISLATURA DE TUCUMÁN
            </h1>
          </div>

         <div id="reloj-box" class="hidden lg:block bg-gray-100 px-6 py-2 rounded-lg border-2 border-gray-300 shadow-inner transition-all duration-300">
            <span id="clock" class="font-mono text-2xl font-bold text-red-900">
              00:00:00
            </span>
          </div>

        </div>
      </header>

      <!-- TAQUIGRAFOS -->
      <div
        id="taquigrafos-bar"
        class="bg-red-950 text-white text-center shadow-md py-3 transition-all duration-300"
      >
        <h2 class="text-base md:text-sm font-bold tracking-widest uppercase">
          <i class="bi bi-book-half mr-2"></i>
          DIRECCIÓN DE TAQUÍGRAFOS
        </h2>
      </div>

    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container mx-auto px-4 pt-[220px] min-h-screen">
      <slot />
    </div>

    <!-- BOTÓN FLOTANTE WHATSAPP -->
    <a 
      href="https://wa.me/5493811234567" 
      target="_blank"
      class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-600 text-white px-5 py-4 rounded-full shadow-xl hover:scale-110 transition-all duration-300 flex items-center gap-2 group"
    >
      <i class="bi bi-whatsapp text-3xl"></i>
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-500 whitespace-nowrap font-bold">
        WhatsApp
      </span>
    </a>

    <!-- Script para el Reloj -->
    <script>
      function updateClock() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('es-AR');
        const clockElement = document.getElementById('clock');
        if (clockElement) clockElement.textContent = timeString;
      }

      setInterval(updateClock, 1000);
      updateClock();

      window.addEventListener('scroll', () => {
        const logo = document.getElementById('logo');
        const titulo = document.getElementById('titulo');
        const reloj = document.getElementById('reloj-box');
        const barra = document.getElementById('taquigrafos-bar');

        if (window.scrollY > 100) {
          logo.style.height = '50px';
          titulo.style.fontSize = '1.4rem';
          reloj.style.padding = '6px 12px';
          barra.style.paddingTop = '6px';
          barra.style.paddingBottom = '6px';
        } else {
          logo.style.height = '50px';
          titulo.style.fontSize = '';
          reloj.style.padding = '';
          barra.style.paddingTop = '';
          barra.style.paddingBottom = '';
        }
      });
    </script>
  </body>
</html>